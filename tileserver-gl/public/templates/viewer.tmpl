<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{name}} - TileServer GL</title>
  <link rel="stylesheet" type="text/css" href="{{public_url}}maplibre-gl.css{{&key_query}}" />
  <link rel="stylesheet" type="text/css" href="{{public_url}}leaflet.css{{&key_query}}" />
  <!-- maplibre-gl.js bundles maplibre-gl v6 + the inspect plugin (esbuild); it exposes window.maplibregl and window.MaplibreInspect. -->
  <script src="{{public_url}}maplibre-gl.js{{&key_query}}"></script>
  <script src="{{public_url}}leaflet.js{{&key_query}}"></script>
  <script src="{{public_url}}leaflet-hash.js{{&key_query}}"></script>
  <style>
    body { margin:0; padding:0; }
    #map { position:absolute; top:0; bottom:0; width:100%; }
    .leaflet-control-layers-toggle {
      background-image: url({{public_url}}images/layers.png{{&key_query}});
      width: 36px;
      height: 36px;
    }
    .leaflet-retina .leaflet-control-layers-toggle {
      background-image: url({{public_url}}images/layers-2x.png{{&key_query}});
      background-size: 26px 26px;
    }
    .leaflet-default-icon-path { /* used only in path-guessing heuristic, see L.Icon.Default */
      background-image: url({{public_url}}images/marker-icon.png{{&key_query}});
    }
    .theme-switch button {
      font: 16px/1 system-ui, sans-serif;
      width: 29px;
      height: 29px;
      cursor: pointer;
      background: none;
      border: 0;
    }
  </style>
</head>
<body>
  <h1 style="display:none;">{{name}}</h1>
  <div id='map'></div>
  <script>
    // MapLibre GL JS 6 needs WebGL 2; a browser with only WebGL 1 cannot run the vector view.
    function isWebgl2Supported() {
        if (window.WebGL2RenderingContext) {
            const canvas = document.createElement('canvas');
            try {
                const context = canvas.getContext('webgl2');
                if (context && typeof context.getParameter == 'function') {
                    return true;
                }
            } catch (e) {
                // WebGL 2 is supported, but disabled
            }
            return false;
        }
        // WebGL 2 not supported
        return false;
    }
    // The light image does not render raster tiles, so it has no view to fall back to.
    var rasterAvailable = {{#if is_light}}false{{else}}true{{/if}};

    // Swaps #map for an empty element: a MapLibre constructor that throws may already have filled the old one.
    function freshMapContainer() {
      var old = document.getElementById('map');
      var fresh = document.createElement('div');
      fresh.id = 'map';
      old.parentNode.replaceChild(fresh, old);
      return fresh;
    }

    function showMapUnavailable() {
      var container = freshMapContainer();
      container.style.cssText = 'display:flex;align-items:center;justify-content:center;padding:24px;' +
        'box-sizing:border-box;font-family:sans-serif;text-align:center;color:#333;background:#f4f4f4;';
      container.textContent = 'This map needs WebGL 2, which this browser does not provide or has turned off. ' +
        'Try another browser, or enable hardware acceleration.';
    }

    // Returns null when MapLibre cannot start - since 6.7 its constructor throws when the WebGL 2 context cannot be created.
    function createVectorMap() {
      try {
        return new maplibregl.Map({
          container: 'map',
          style: '{{public_url}}styles/{{id}}/style.json' + keyParam,
          hash: true,
          maxPitch: 85
        });
      } catch (err) {
        console.error('Vector map unavailable:', err);
        freshMapContainer();
        return null;
      }
    }
    var q = (location.search || '').substr(1).split('&');
    var preference =
      !rasterAvailable || q.indexOf('vector') >= 0 ? 'vector' :
        (q.indexOf('raster') >= 0 ? 'raster' :
          (isWebgl2Supported() ? 'vector' : 'raster'));

    var keyMatch = location.search.match(/[\?\&]key=([^&]+)/i);
    var keyParam = keyMatch ? '?key=' + keyMatch[1] : '';

    // --- light/dark theme switch ------------------------------------------
    // A style participates when both "<id>" and "<id>-dark" are served, so
    // pairing is by naming convention and needs no server-side config.
    //
    // The choice is deliberately NOT persisted anywhere. The current theme is
    // the style in the URL, which the toggle keeps in sync, so each tab holds
    // its own theme, a reload keeps it, and the link stays shareable.
    var lightId = '{{id}}'.replace(/-dark$/, '');
    var darkId = lightId + '-dark';
    var isDark = '{{id}}' === darkId;

    function styleUrlFor(id) {
      return '{{public_url}}styles/' + id + '/style.json' + keyParam;
    }

    function makeThemeButton(onClick) {
      var container = document.createElement('div');
      container.className = 'maplibregl-ctrl maplibregl-ctrl-group theme-switch';
      var button = document.createElement('button');
      button.type = 'button';
      button.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        onClick();
      });
      container.appendChild(button);
      container.refresh = function () {
        // Show the theme you would get by clicking, not the current one.
        button.textContent = isDark ? '☀' : '☾';
        var label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
        button.title = label;
        button.setAttribute('aria-label', label);
      };
      container.refresh();
      return container;
    }

    // Keep the address bar on the style that is actually displayed, so the
    // URL stays copy-pasteable after a switch.
    function syncLocation(id) {
      if (!window.history || !history.replaceState) return;
      history.replaceState(null, '', '{{public_url}}styles/' + id + '/' + location.search + location.hash);
    }

    // Adds the control only when the counterpart style exists.
    function setupThemeSwitch(map, mode) {
      var url = '{{public_url}}styles.json' + keyParam;
      fetch(url).then(function (r) { return r.json(); }).then(function (styles) {
        var ids = styles.map(function (s) { return s.id; });
        if (ids.indexOf(lightId) === -1 || ids.indexOf(darkId) === -1) return;

        var control;
        var apply = function (dark) {
          isDark = dark;
          var id = dark ? darkId : lightId;
          if (mode === 'vector') {
            // setStyle keeps the camera, so position and zoom survive.
            map.setStyle(styleUrlFor(id));
            syncLocation(id);
            control.refresh();
          } else {
            // Raster viewer: the tiles are pre-rendered per style, so reload
            // onto the counterpart's viewer instead of swapping a layer.
            location.href = '{{public_url}}styles/' + id + '/' + location.search + location.hash;
          }
        };

        control = makeThemeButton(function () { apply(!isDark); });

        if (mode === 'vector') {
          map.addControl({
            onAdd: function () { return control; },
            onRemove: function () { control.remove(); }
          }, 'top-right');
        } else {
          var Ctl = L.Control.extend({
            options: { position: 'topright' },
            onAdd: function () { return control; }
          });
          map.addControl(new Ctl());
        }
      }).catch(function () { /* no styles.json - leave the viewer as it is */ });
    }

    // Falls back to the raster view when the vector map cannot start, or to a message where there is none.
    var map = preference == 'vector' ? createVectorMap() : null;
    if (map) {
      // v6 warns for any icon-image a style names but its sprite lacks.
      // Resolve each to an invisible 1x1 pixel, matching the sprite's SDF-ness (streets/ basic are SDF, osm-openmaptiles isn't)
      // so it doesn't trip "Cannot mix SDF and non-SDF icons".
      map.setMissingStyleImageResolver(function (id) {
        if (map.hasImage(id)) return;
        var sdf = false, existing = map.listImages();
        for (var i = 0; i < existing.length; i++) {
          var img = map.getImage(existing[i]);
          if (img) { sdf = !!img.sdf; break; }
        }
        map.addImage(id, { width: 1, height: 1, data: new Uint8Array(4) }, { sdf: sdf });
      });
      map.addControl(new maplibregl.GlobeControl());
      map.addControl(new maplibregl.NavigationControl({
         visualizePitch: true,
         showZoom: true,
         showCompass: true
      }));

      //check if terrain is available, before enabling the control
      var terrainControlAdded = false;
      map.on('style.load', function () {
        // style.load fires again after a theme switch; only add the control once.
        if (terrainControlAdded) return;
        var terrainId = null;
        Object.entries(map.getStyle().sources).some(function (source) {
          if (source[1].type == "raster-dem") {
            terrainId = source[0];
            return true;
          }
        });

        if (terrainId) {
          map.addControl(
            new maplibregl.TerrainControl({
              source: terrainId,
            })
          );
          terrainControlAdded = true;
        }
      });

      map.addControl(new MaplibreInspect({
         showMapPopupOnHover: false,
         showInspectMapPopupOnHover: false,
         selectThreshold: 5
      }));

      setupThemeSwitch(map, 'vector');
    } else if (rasterAvailable) {
        map = L.map('map', { minZoom: 1, zoomControl: false });
        new L.Control.Zoom({ position: 'topright' }).addTo(map);
        
        var tile_urls = [], tile_attribution, tile_minzoom, tile_maxzoom;
        var url = '{{public_url}}styles/512/{{id}}.json' + keyParam;
        var req = new XMLHttpRequest();
        req.overrideMimeType("application/json");
        req.open('GET', url, true);
        req.onload = function() {
            var jsonResponse = JSON.parse(req.responseText);
            for (key in jsonResponse) {
              var keyl = key.toLowerCase();
                switch(keyl) {
                  case "tiles":
                    tile_urls = jsonResponse[key];
                    break;
                  case "attribution":
                    tile_attribution = jsonResponse[key];
                    break;
                  case "minzoom":
                    tile_minzoom = jsonResponse[key];
                    break;
                  case "maxzoom":
                    tile_maxzoom = jsonResponse[key];
                    break;
                }
            }

            for (tile_url in tile_urls) {
                var leafletUrl = tile_urls[tile_url];
                {{#leaflet_retina}}
                // Inject {r} for Leaflet retina support without modifying TileJSON directly.
                // Make this robust by operating on the {y} token itself and avoiding duplicate {r}.
                if (leafletUrl.indexOf('{r}') === -1 && leafletUrl.indexOf('{y}') !== -1) {
                    leafletUrl = leafletUrl.replace('{y}', '{y}{r}');
                }
                {{/leaflet_retina}}
                L.tileLayer(leafletUrl, {
                    tileSize: 512,
                    zoomOffset: -1,
                    minZoom: tile_minzoom,
                    maxZoom: tile_maxzoom,
                    attribution: tile_attribution
                }).addTo(map);
            }
        };
        req.send(null);
      
        setTimeout(function() {
            new L.Hash(map);
        }, 0);

        setupThemeSwitch(map, 'raster');
    } else {
      showMapUnavailable();
    }
  </script>
</body>
</html>
