# Vector-tiles-only ("light") build of tileserver-gl.
#
# Serves vector tiles, styles, fonts, sprites and the viewer, but does no
# server-side rasterization: no /styles/<id>/<z>/<x>/<y>.png, no /static/
# endpoints, no elevation queries. Light mode is selected by the package
# name ending in `-light` (see src/server.js), which swaps serve_rendered.js
# for the no-op stubs in src/serve_light.js.
#
# Dropping the renderer removes maplibre-gl-native, canvas and sharp, and
# with them the whole GL stack (mesa + LLVM software rasterizer, GLFW, Xvfb)
# and the cairo/pango/rsvg image stack.
#
# Data source is orthogonal to the image. The same build serves either:
#   * local files under /data (a bind mount in dev, or baked into a child
#     image) — the traditional layout; or
#   * remote PMTiles on S3 / any S3-compatible store (MinIO, R2, …) or plain
#     HTTP, by pointing a config.json data source at an s3://, s3+https://,
#     s3+http:// or https:// URL. The @aws-sdk/client-s3 and pmtiles packages
#     that make this work already ship here; nothing extra is installed.
#     Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID /
#     AWS_SECRET_ACCESS_KEY env vars, a mounted ~/.aws profile via s3Profile,
#     or an IAM role) — never from config.json. See tileserver-gl-dev/
#     compose.s3.yml for a private-bucket MinIO example.
#
#   docker build -f Dockerfile_light . -t tileserver-gl-light

FROM ubuntu:noble AS builder

ENV NODE_ENV="production"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Only sqlite3 still compiles here, and only if no prebuilt binary matches
# the target platform. The toolchain never reaches the final stage.
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
      build-essential \
      python3-setuptools \
      ca-certificates \
      curl \
      gnupg \
      pkg-config && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests nodejs && \
    npm i -g npm@latest && \
    apt-get -y remove curl gnupg && \
    apt-get -y --purge autoremove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY package.json package-lock.json ./

# Drop the renderer-only dependencies before installing. This is why the
# install below is `npm install` and not `npm ci`: package.json no longer
# matches the lockfile. Versions of everything that remains still come from
# package-lock.json.
RUN node -e ' \
      const fs = require("fs"); \
      const pkg = JSON.parse(fs.readFileSync("package.json", "utf8")); \
      for (const dep of ["canvas", "@maplibre/maplibre-gl-native", "sharp"]) { \
        delete pkg.dependencies[dep]; \
      } \
      fs.writeFileSync("package.json", JSON.stringify(pkg, null, 2) + "\n"); \
    '

RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 100000 && \
    npm config set fetch-retry-maxtimeout 600000 && \
    npm install --omit=dev --no-audit --no-fund && \
    chown -R root:root /usr/src/app

# The browser bundles were already copied into public/resources by the
# `prepare` lifecycle script above, and the gyp toolchain is never used
# again once sqlite3 is built.
RUN rm -rf \
      node_modules/maplibre-gl \
      node_modules/leaflet \
      node_modules/leaflet-hash \
      node_modules/@maplibre/maplibre-gl-inspect \
      node_modules/@mapbox/mapbox-gl-rtl-text \
      node_modules/copyfiles \
      node_modules/node-gyp \
      node_modules/@octokit \
      node_modules/@acalcutt

# --- Final Stage ---
FROM ubuntu:noble AS final

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# node bundles its own ICU and libuv, so the runtime needs nothing beyond a
# CA bundle and jemalloc. Every other library the full image installs is
# there for the renderer.
RUN export DEBIAN_FRONTEND=noninteractive && \
    groupadd -r node && \
    useradd -r -g node node && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
      ca-certificates \
      curl \
      gnupg \
      libjemalloc2 && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests nodejs && \
    # Create appropriate symlinks if needed
    ln -sf "$(find /usr -name "libjemalloc.so*" | head -n 1)" /usr/lib/libjemalloc.so && \
    apt-get -y remove curl gnupg && \
    apt-get -y --purge autoremove && \
    apt-get clean && \
    # The runtime only ever executes `node`. The nodejs package also ships
    # addon headers, npm and corepack, none of which are used here.
    rm -rf \
      /usr/include/node \
      /usr/lib/node_modules \
      /usr/bin/npm /usr/bin/npx /usr/bin/corepack \
      /usr/share/doc /usr/share/man /usr/share/locale \
      /var/lib/apt/lists/*

RUN mkdir -p /home/node/.aws && \
    chown -R node:node /home/node

ENV \
    NODE_ENV="production" \
    HOME="/home/node" \
    CHOKIDAR_USEPOLLING=1 \
    CHOKIDAR_INTERVAL=500 \
    LD_PRELOAD="/usr/lib/libjemalloc.so" \
    MALLOC_CONF="background_thread:true,metadata_thp:auto,dirty_decay_ms:5000,muzzy_decay_ms:5000"

COPY --from=builder /usr/src/app /usr/src/app
COPY . /usr/src/app

# `COPY . ` restored the original package.json, so re-apply the light
# manifest here: the `-light` name suffix is what makes src/server.js and
# src/serve_data.js load serve_light.js instead of serve_rendered.js.
RUN node -e ' \
      const fs = require("fs"); \
      const pkg = JSON.parse(fs.readFileSync("/usr/src/app/package.json", "utf8")); \
      pkg.name = "tileserver-gl-light"; \
      for (const dep of ["canvas", "@maplibre/maplibre-gl-native", "sharp"]) { \
        delete pkg.dependencies[dep]; \
        delete pkg.allowScripts[dep + "@" + "*"]; \
      } \
      for (const key of Object.keys(pkg.allowScripts)) { \
        if (/^(canvas|@maplibre\/maplibre-gl-native)@/.test(key)) delete pkg.allowScripts[key]; \
      } \
      fs.writeFileSync("/usr/src/app/package.json", JSON.stringify(pkg, null, 2) + "\n"); \
    ' && \
    rm -rf /usr/src/app/src/serve_rendered.js /usr/src/app/src/render.js

# No VOLUME on /data. A tile server never writes there, so an anonymous volume
# buys nothing — and it actively hurts the two ways /data is populated: it masks
# assets baked into a child image (see Dockerfile_light_s3) by seeding a separate
# stateful volume, and it leaves a stray volume behind on stateless deployments.
# A bind mount (dev) or a child image's baked files serve /data directly.
RUN mkdir -p /data && chown node:node /data
WORKDIR /data

EXPOSE 8080

USER node:node

ENTRYPOINT ["/usr/src/app/docker-entrypoint.sh"]

HEALTHCHECK CMD node /usr/src/app/src/healthcheck.js
