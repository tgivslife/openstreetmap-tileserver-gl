{
  "options": {
    "paths": {
      "root": "/data",
      "fonts": "fonts",
      "styles": "styles",
      "mbtiles": "/data/mbtiles",
      "pmtiles": "/data/pmtiles"
    },
    "serveAllFonts": true
  },
  "styles": {
    "osm-openmaptiles": {
      "style": "osm-openmaptiles/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    },
    "osm-openmaptiles-dark": {
      "style": "osm-openmaptiles-dark/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    },
    "streets-v2": {
      "style": "streets-v2/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    },
    "streets-v2-dark": {
      "style": "streets-v2-dark/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    },
    "basic-v2": {
      "style": "basic-v2/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    },
    "basic-v2-dark": {
      "style": "basic-v2-dark/style.json",
      "mapping": { "planet-planetiler": "planet-tilemaker" }
    }
  },
  "data": {
    "romania-tilemaker": {
      "mbtiles": "romania-latest.tilemaker.mbtiles"
    },
    "planet-tilemaker": {
      "mbtiles": "planet-latest.tilemaker.mbtiles"
    }
  }
